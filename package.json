{
  "name": "token-ledger-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun packages/cli/src/main.ts",
    "build": "bun build packages/cli/src/main.ts --target=node --outfile=packages/cli/dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write packages scripts '*.json' '*.md' .github .vscode",
    "format:check": "prettier --check packages scripts '*.json' '*.md' .github .vscode",
    "reference:update": "node scripts/update-references.mjs"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.117",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
